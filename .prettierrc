{
    "overrides": [
        {
            "files": "*.sol",
            "options": {
                "printWidth": 120,
                "tabWidth": 4,
                "useTabs": false,
                "singleQuote": false,
                "bracketSpacing": true
            }
        },
        {
            "files": "*.js",
            "options": {
                "printWidth": 120,
                "tabWidth": 4,
                "semi": true,
                "singleQuote": false
            }
        }
    ]
}
